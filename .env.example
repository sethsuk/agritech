# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase Dashboard → Project Settings → API

# Public URL and anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# Service role key — server-only, NEVER expose to the browser.
# Used for all server-side DB writes that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# GPS tolerance in meters for QR/location mismatch validation (default: 15).
GPS_TOLERANCE_METERS=15
